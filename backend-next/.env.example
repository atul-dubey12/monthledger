# Copy to .env.local. Never commit credentials. Use Neon's pooled URL, not a JDBC URL.
DATABASE_URL=postgresql://user:password@your-neon-host-pooler/database?sslmode=require
# Required in production and Vercel previews; minimum 32 characters.
# Generate with: openssl rand -hex 32
API_KEY=
# Exact frontend origins, comma-separated, with no trailing slash.
ALLOWED_ORIGINS=http://localhost:4201
APP_TIME_ZONE=UTC
